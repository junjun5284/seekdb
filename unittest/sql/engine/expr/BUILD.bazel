load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//bazel:defs.bzl", "cc_library")

package(default_testonly = True)

cc_library(
    name = "ai_prompt_test_cases",
    srcs = ["ob_expr_ai_prompt_test.cpp"],
    alwayslink = True,
    deps = [
        "//bazel/third_party:gtest",
        "//src/sql:sql_unit_test_internal_headers",
    ],
)

cc_library(
    name = "openai_utils_test_cases",
    srcs = ["test_ob_openai_utils.cpp"],
    alwayslink = True,
    deps = [
        "//bazel/third_party:gtest",
        "//src/sql:sql_unit_test_internal_headers",
    ],
)

cc_test(
    name = "test_ob_expr_ai_prompt",
    linkstatic = True,
    features = ["-static_cpp_runtime", "-static_link_cpp_runtimes"],
    deps = [
        ":ai_prompt_test_cases",
        "//src/observer:liboceanbase",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)

cc_test(
    name = "test_ob_openai_utils",
    linkstatic = True,
    features = ["-static_cpp_runtime", "-static_link_cpp_runtimes"],
    deps = [
        ":openai_utils_test_cases",
        "//src/observer:liboceanbase",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)
